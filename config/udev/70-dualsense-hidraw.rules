# Permit members of the input group to read DualSense raw reports. The kernel
# evdev interface omits the physical microphone-mute button, so the read-only
# input test uses hidraw for that single bit. Supports DualSense and Edge over
# Bluetooth (0005) and USB (0003).
SUBSYSTEM=="hidraw", KERNELS=="0005:054C:0CE6.*", GROUP="input", MODE="0660"
SUBSYSTEM=="hidraw", KERNELS=="0003:054C:0CE6.*", GROUP="input", MODE="0660"
SUBSYSTEM=="hidraw", KERNELS=="0005:054C:0DF2.*", GROUP="input", MODE="0660"
SUBSYSTEM=="hidraw", KERNELS=="0003:054C:0DF2.*", GROUP="input", MODE="0660"
